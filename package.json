{
  "name": "haraka-plugin-geoip",
  "version": "1.1.2",
  "description": "provide geographic information about mail senders.",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "format": "npm run prettier:fix && npm run lint:fix",
    "lint": "npx eslint index.js test/*.js",
    "lint:fix": "npx eslint --fix index.js test/*.js",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npx prettier . --write --log-level=warn",
    "qlty": "qlty smells --all",
    "test": "node --test test/*.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=package.json --test-coverage-exclude=test/*.js test/*.js",
    "test:coverage:lcov": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.js",
    "versions": "npx dependency-version-checker check",
    "versions:fix": "npx dependency-version-checker update"
  },
  "c8": {
    "reporter": [
      "text",
      "text-summary",
      "html"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haraka/haraka-plugin-geoip.git"
  },
  "keywords": [
    "haraka",
    "email",
    "geoip",
    "smtp",
    "mta"
  ],
  "author": "Matt Simerson <matt@tnpi.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/haraka/haraka-plugin-geoip/issues"
  },
  "homepage": "https://github.com/haraka/haraka-plugin-geoip#readme",
  "devDependencies": {
    "@haraka/eslint-config": "^2.0.4",
    "haraka-test-fixtures": "^1.7.0"
  },
  "dependencies": {
    "haraka-net-utils": "^1.7.2",
    "maxmind": "^5.0.5"
  },
  "files": [
    "CHANGELOG.md",
    "config"
  ]
}
